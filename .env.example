# ---------------------------------------------------------------
# QuickCred environment template. Copy to .env and fill locally.
# NEVER commit real values. Provider secrets live server-side only;
# nothing prefixed NEXT_PUBLIC_ may ever hold a secret.
# ---------------------------------------------------------------

NODE_ENV=development
APP_ENV=local                     # local | staging | production

# --- Integration mode ------------------------------------------
# mock  = labelled mock adapters only (the ONLY allowed value today)
# live  = refused at boot unless LENDER_AUTHORIZATION_REF is set and
#         each provider's *_MODE is individually set to live.
INTEGRATION_MODE=mock
LENDER_AUTHORIZATION_REF=          # signed lender/LSP agreement reference; empty = no live paths

# --- Database / cache ------------------------------------------
DATABASE_URL=postgres://quickcred:quickcred_local_only@localhost:5432/quickcred
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Web ---------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_BANNER=true       # shows "Demo: no real loans" banner

# --- Auth --------------------------------------------------------
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_SIGNING_KEY_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5

# --- Encryption (envelope) --------------------------------------
# local: a 32-byte base64 key for dev only. staging/prod: AWS KMS key ARN in ap-south-1.
KMS_PROVIDER=local                 # local | aws
LOCAL_MASTER_KEY_BASE64=
AWS_REGION=ap-south-1
AWS_KMS_KEY_ARN=
BLIND_INDEX_PEPPER_BASE64=         # HMAC pepper for PAN/phone duplicate lookup

# --- Providers (all mock until lender + provider contracts exist) ---
SMS_MODE=mock
SMS_PROVIDER=
SMS_API_KEY=
SMS_DLT_ENTITY_ID=

PAN_MODE=mock
PAN_PROVIDER=
PAN_API_KEY=

KYC_MODE=mock
KYC_PROVIDER=                       # e.g. DigiLocker / offline XML via lender's KUA
KYC_API_KEY=

AA_MODE=mock
AA_PROVIDER=                        # finvu | onemoney | camsfinserv | ...
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_FIU_ID=                          # must be the regulated lender's FIU id

BUREAU_MODE=mock
BUREAU_PROVIDER=                    # cibil | experian | crif | equifax (lender's membership)
BUREAU_MEMBER_ID=
BUREAU_API_KEY=

ESIGN_MODE=mock
ESIGN_PROVIDER=
ESIGN_API_KEY=

PAYOUT_MODE=mock
PAYOUT_PROVIDER=                    # lender's own bank / PA account, never a QuickCred pool
PAYOUT_API_KEY=
PAYOUT_WEBHOOK_SECRET=

COLLECTIONS_MODE=mock
PG_PROVIDER=
PG_KEY_ID=
PG_KEY_SECRET=
PG_WEBHOOK_SECRET=

# --- Observability ----------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
